# Khylo Server settings. Most people never need to change anything here.
# After editing, run:  sudo systemctl restart khylo

# Where Khylo keeps its settings, users and library (back this folder up)
KHYLO_DATA_DIR=/var/lib/khylo
KHYLO_CONFIG_DIR=/var/lib/khylo/config
# Artwork and temporary transcodes; safe to delete
KHYLO_CACHE_DIR=/var/cache/khylo
KHYLO_LOG_DIR=/var/log/khylo
KHYLO_WEB_DIR=/opt/khylo/web

# Network shares added in Khylo are connected under this folder
KHYLO_SHARES_DIR=/var/lib/khylo/shares
KHYLO_MOUNT_HELPER=/usr/lib/khylo/khylo-mount

LANG=C.UTF-8
LC_ALL=C.UTF-8
MALLOC_TRIM_THRESHOLD_=131072
XDG_CACHE_HOME=/var/cache/khylo
